.DS_Store
**/.DS_Store
*.log
.env
.env.*
!.env.example

# Nested product git repos at repo root only (tracked separately)
# Use leading slash so suite paths like cfg/docker/groups/hath0r/ are not ignored.
/hath0r/
/hathor-cli/
/hath0r-mcp/
/hath0r-poc/

# Site build artifacts
site/**/node_modules/
site/**/.venv/
site/**/dist/
site/**/__pycache__/

# Editor / local
.idea/
.vscode/
*.swp
# Python artifacts
__pycache__/
*.py[cod]
.pytest_cache/

# Hath0r runtime state
.hath0r/state/*
.hath0r/events.jsonl
.hath0r/finops/

config.json

# Hath0r runtime
.hath0r/events.jsonl
.hath0r/finops/

# Canonical Hath0r Graph Folders (NEVER ignore — CR-MEMORY-COMPOUND-001 & CR-AGENTGRAPH-001)
!.hath0r/
!.hath0r/memory/
!.hath0r/memory/**
!.hath0r/memory/sessions/
!.hath0r/memory/sessions/**
!.hath0r/agentgraph/
!.hath0r/agentgraph/**
!.hath0r/graphs/
!.hath0r/graphs/**
!.hath0r/state/
!.hath0r/state/cache/
!.hath0r/state/cache/**
!.hath0r/state/context/
!.hath0r/state/context/**

!.hath0r/mcp.json
